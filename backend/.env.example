DB_URL=jdbc:mysql://127.0.0.1:3306/paike?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# 数据库账号/密码必须显式提供；请使用本地专用低权限账号，不要照抄 root。
DB_USERNAME=paike_app
DB_PASSWORD=change_me_local_db_password
# JWT_SECRET 必须 >= 32 字节强随机串；部署和联调前必须替换。
JWT_SECRET=change_me_generate_32_bytes_minimum_secret
JWT_EXPIRATION_MS=86400000
# 可选：注入默认管理员初始密码（不设置则随机生成并打印到 stdout）
# ADMIN_DEFAULT_PASSWORD=
