DB_URL=jdbc:mysql://127.0.0.1:3306/paike?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# 数据库账号/密码必须显式提供，不再保留 root/123456 默认值
DB_USERNAME=root
DB_PASSWORD=root
# JWT_SECRET 必须 >= 32 字节强随机串；不能保留这里的占位符
JWT_SECRET=replace_with_a_strong_secret_at_least_32_bytes_long_xxx
JWT_EXPIRATION_MS=86400000
# 可选：注入默认管理员初始密码（不设置则随机生成并打印到 stdout）
# ADMIN_DEFAULT_PASSWORD=
